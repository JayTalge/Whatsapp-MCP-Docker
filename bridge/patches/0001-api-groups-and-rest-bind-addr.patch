+	mux.HandleFunc("/api/groups", auth(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+
+		groups, err := client.GetJoinedGroups(r.Context())
+		if err != nil {
+			fmt.Printf("← /api/groups error: %v\n", err)
+			http.Error(w, "Failed to list groups", http.StatusInternalServerError)
+			return
+		}
+
+		type groupInfo struct {
+			JID  string `json:"jid"`
+			Name string `json:"name"`
+		}
+		out := make([]groupInfo, 0, len(groups))
+		for _, g := range groups {
+			out = append(out, groupInfo{JID: g.JID.String(), Name: g.Name})
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{"groups": out})
+	}))
+
 	return mux
 }
 
@@ -2667,7 +2693,14 @@ func startRESTServer(client *whatsmeow.Client, messageStore *MessageStore, port
 
 	// Start the server with proper timeouts. Bind to loopback so the bridge is
 	// not reachable from the LAN; MCP clients talk to it over localhost.
-	serverAddr := fmt.Sprintf("127.0.0.1:%d", port)
+	// REST_BIND_ADDR overrides the loopback default for deployments that
+	// front the bridge with a reverse proxy; the proxy must rewrite Host to
+	// a loopback form (see buildAllowedHosts) or requests are rejected.
